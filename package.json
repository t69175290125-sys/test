{
  "name": "qanc-demo-shop",
  "version": "1.0.0",
  "private": true,
  "description": "Demo web shop + Playwright regression suite for trying the QA Nerve Center CI/CD flow end to end",
  "scripts": {
    "start": "node app/server.js",
    "test": "playwright test --project=chromium",
    "test:smoke": "playwright test --project=chromium tests/smoke",
    "test:regression": "playwright test --project=chromium tests/regression",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
